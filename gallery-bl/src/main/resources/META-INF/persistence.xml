<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
    <persistence-unit name="trainingPersistence">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>lt.insoft.training.model.ImageDetails</class>
        <class>lt.insoft.training.model.Folder</class>
        <class>lt.insoft.training.model.Image</class>
        <class>lt.insoft.training.model.User</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>