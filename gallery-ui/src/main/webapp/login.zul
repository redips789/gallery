<?link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" ?>
<?script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"?>
<?script src="js/login.js"?>
<?link rel="stylesheet" type="text/css"    href="css/login-form.css"?>
<zk xmlns="xhtml" xmlns:zul="http://www.zkoss.org/2005/zul">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="panel panel-login">
                    <div class="panel-heading">
                        <div class="row">
                            <div class="col-xs-6">
                                <a href="#" class="active" id="login-form-link">Login</a>
                            </div>
                            <div class="col-xs-6">
                                <a href="#" id="register-form-link">Register</a>
                            </div>
                        </div>
                        <!--<hr>-->
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-lg-12">
                                <form id="login-form" action="j_spring_security_check" method="post" role="form" style="display: block;">
                                    <div class="form-group">
                                        <zul:textbox name="username" id="username" tabindex="1" sclass="form-control" placeholder="Username"> </zul:textbox>
                                    </div>
                                    <div class="form-group">
                                        <zul:textbox type="password" name="password" id="password" tabindex="2" sclass="form-control" placeholder="Password"> </zul:textbox>
                                        <input type="hidden" name="${_csrf.parameterName}"
                                        value="${_csrf.token}"/>
                                    </div>
                                    <div class="form-group text-center">
                                        <input type="checkbox" tabindex="3" class="" name="remember" id="remember"> </input>
                                        <label for="remember"> Remember Me</label>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-sm-6 col-sm-offset-3">
                                                <input type="submit" name="login-submit" id="login-submit" tabindex="4" class="form-control btn btn-login" value="Log In"> </input>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <div class="text-center">
                                                    <a href="http://phpoll.com/recover" tabindex="5" class="forgot-password">Forgot Password?</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                                <form id="register-form" action="j_spring_security_check" method="post" role="form" style="display: none;">
                                    <div class="form-group">
                                        <textbox type="text" id="usernameR" tabindex="1" sclass="form-control" placeholder="Username" value=""> </textbox>
                                    </div>
                                    <div class="form-group">
                                        <input type="email" name="email" id="email" tabindex="1" class="form-control" placeholder="Email Address" value=""> </input>
                                    </div>
                                    <div class="form-group">
                                        <textbox type="password"  id="passwordR" tabindex="2" sclass="form-control" placeholder="Password"> </textbox>
                                    </div>
                                    <div class="form-group">
                                        <textbox type="password" id="confirm-passwordR" tabindex="2" sclass="form-control" placeholder="Confirm Password"> </textbox>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-sm-6 col-sm-offset-3">
                                                <input type="submit" name="register-submit" id="register-submit" tabindex="4" class="form-control btn btn-register" value="Register Now"> </input>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</zk>