<?link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" ?>
<?script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"?>
<?script src="js/test.js"?>
<?link rel="stylesheet" type="text/css"  href="css/custom.css"?>
<zk xmlns="native" xmlns:x="xhtml" xmlns:ca="client/attribute" xmlns:zul="zul">
    <x:div apply="org.zkoss.bind.BindComposer" viewModel="@id('vm')@init('lt.insoft.training.ui.vm.IndexVM')">
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse"
                            data-target="#bs-example-navbar-collapse-1">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <zul:span class="icon-bar"></zul:span>
                        <span class="icon-bar"></span>
                    </button>
                    <zul:a sclass="navbar-brand" zclass="none"
                           onClick="@global-command('changePage', page='index.zul')" label="Gallery"/>
                </div>
                <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <zul:a sclass="navbar-brand" zclass="none"
                               onClick="@global-command('changePage', page='search.zul')" label="Search"/>
                    </ul>
                </div>
                <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <x:form action="/perform_logout"
                                method="post">
                        </x:form>
                    </ul>
                </div>
            </div>
        </nav>
        <zul:include src="@load(vm.currentPageName)" folder="@load(vm.selectedFolder)" image="@load(vm.selectedImage)"/>
        <div class="modal fade" id="myModal" tabindex="-1" role="dialog"
             aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal">&#xd7;</button>
                        <h4>Error</h4>
                    </div>
                    <div class="modal-body">
                        <label id="errorMessage" value=""/>
                    </div>
                    <div class="modal-footer">
                        <div class="col-xs-2">
                            <button class="btn btn-default" data-dismiss="modal">OK</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </x:div>
</zk>
